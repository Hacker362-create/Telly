# backend/.env.example
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────
PORT=3000

# Origins allowed to connect to the signaling server (comma-separated)
# The web UI is served from the same origin, so localhost:3000 is included.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default – no extra services needed for local dev)
DATABASE_URL=file:./dev.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://telly:telly@localhost:5432/telly

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── M-Pesa Daraja 2.0 ────────────────────────────────────────────────
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORT_CODE=174379
MPESA_PASS_KEY=your-mpesa-lipa-na-mpesa-passkey
# Must be a publicly reachable HTTPS URL (use ngrok in dev)
MPESA_CALLBACK_URL=https://your-domain.com/subscription/callback
# Override Safaricom callback IP whitelist if needed (comma-separated IPs)
# MPESA_CALLBACK_IPS=196.201.214.200,...
# Set to 'true' in local dev/sandbox to skip the IP check
MPESA_CALLBACK_BYPASS=false

# ── Firebase Cloud Messaging (push notifications) ────────────────────
# Server key from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key

# ── Mediasoup SFU ────────────────────────────────────────────────────
MEDIASOUP_LISTEN_IP=0.0.0.0
# Public IP of the server (required for ICE candidates to work externally)
MEDIASOUP_ANNOUNCED_IP=your-public-ip
MEDIASOUP_RTC_MIN_PORT=2000
MEDIASOUP_RTC_MAX_PORT=2999
