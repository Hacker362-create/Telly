generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  name               String
  email              String        @unique
  passwordHash       String
  phoneNumber        String        @unique
  isActive           Boolean       @default(false)
  subscriptionExpiry DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
  callsAsCallee      CallLog[]     @relation("callee")
  callsAsCaller      CallLog[]     @relation("caller")
  sentMessages       Message[]     @relation("sent")
  receivedMessages   Message[]     @relation("received")
  voicemailsSent     Voicemail[]   @relation("voicemailsCaller")
  voicemailsReceived Voicemail[]   @relation("voicemailsRecipient")
}

model Transaction {
  id                 String   @id @default(uuid())
  userId             String
  amount             Float
  mpesaReceiptNumber String
  checkoutRequestId  String   @unique
  status             String
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
}

model CallLog {
  id            String    @id @default(uuid())
  callerId      String
  calleeId      String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  durationMs    Int?
  dataBytes     Int?
  recordingUrl  String?
  transcription String?
  caller        User      @relation("caller", fields: [callerId], references: [id])
  callee        User      @relation("callee", fields: [calleeId], references: [id])
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  recipientId String
  body        String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  sender      User      @relation("sent", fields: [senderId], references: [id])
  recipient   User      @relation("received", fields: [recipientId], references: [id])
}

model Voicemail {
  id          String    @id @default(uuid())
  callerId    String
  recipientId String
  audioUrl    String
  durationSec Int
  transcription String?
  leftAt      DateTime  @default(now())
  listenedAt  DateTime?
  caller      User      @relation("voicemailsCaller", fields: [callerId], references: [id])
  recipient   User      @relation("voicemailsRecipient", fields: [recipientId], references: [id])
}
