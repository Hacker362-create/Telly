generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  passwordHash         String
  phoneNumber          String        @unique
  deviceId             String?       @unique
  isAdmin              Boolean       @default(false)
  isActive             Boolean       @default(false)
  subscriptionExpiry   DateTime
  dailyMinutesUsed     Int           @default(0)
  lastResetDate        DateTime?
  referralCode         String?       @unique
  referredBy           String?
  referralCount        Int           @default(0)
  referralRewardsEarned Int          @default(0)
  bonusMinutes         Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tellyId              TellyID?
  contacts             Contact[]     @relation("contactOwner")
  contactedBy          Contact[]     @relation("contactUser")
  transactions         Transaction[]
  callsAsCallee        CallLog[]     @relation("callee")
  callsAsCaller        CallLog[]     @relation("caller")
  sentMessages         Message[]     @relation("sent")
  receivedMessages     Message[]     @relation("received")
  voicemailsSent       Voicemail[]   @relation("voicemailsCaller")
  voicemailsReceived   Voicemail[]   @relation("voicemailsRecipient")
  analyticsAsCaller    CallAnalytics[] @relation("analyticsCaller")
  analyticsAsCallee    CallAnalytics[] @relation("analyticsCallee")
  feedbacks            Feedback[]    @relation("feedbackUser")

  @@index([referralCode])
}

model Transaction {
  id                 String   @id @default(uuid())
  userId             String
  amount             Float
  mpesaReceiptNumber String
  checkoutRequestId  String   @unique
  status             String
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
}

model CallLog {
  id                   String    @id @default(uuid())
  callerId             String
  calleeId             String
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  durationMs           Int?
  dataBytes            Int?
  recordingUrl         String?
  transcription        String?
  estimatedAirtimeCost Float?
  estimatedSavingsKes  Float?
  caller               User      @relation("caller", fields: [callerId], references: [id])
  callee               User      @relation("callee", fields: [calleeId], references: [id])
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  recipientId String
  body        String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  sender      User      @relation("sent", fields: [senderId], references: [id])
  recipient   User      @relation("received", fields: [recipientId], references: [id])
}

model Voicemail {
  id          String    @id @default(uuid())
  callerId    String
  recipientId String
  audioUrl    String
  durationSec Int
  transcription String?
  leftAt      DateTime  @default(now())
  listenedAt  DateTime?
  caller      User      @relation("voicemailsCaller", fields: [callerId], references: [id])
  recipient   User      @relation("voicemailsRecipient", fields: [recipientId], references: [id])
}

model CallAnalytics {
  id                 String   @id @default(uuid())
  callId             String   @unique
  callerId           String
  calleeId           String
  startedAt          DateTime
  endedAt            DateTime
  durationMs         Int
  dataBytes          Int
  avgLatencyMs       Float
  packetLossPct      Float
  networkType        String
  iceRestartCount    Int      @default(0)
  relayUsed          Boolean  @default(false)
  reconnectionEvents Int      @default(0)
  success            Boolean  @default(false)
  createdAt          DateTime @default(now())
  caller             User     @relation("analyticsCaller", fields: [callerId], references: [id])
  callee             User     @relation("analyticsCallee", fields: [calleeId], references: [id])

  @@index([callerId, endedAt])
  @@index([calleeId, endedAt])
  @@index([endedAt])
}

model Incident {
  id             String   @id @default(uuid())
  type           String
  level          String
  code           String
  title          String
  message        String
  status         String   @default("OPEN")
  source         String   @default("SYSTEM")
  callId         String?
  createdBy      String?
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([level, createdAt])
  @@index([callId])
}

model TellyID {
  id             String   @id @default(uuid())
  userId         String   @unique
  tellyId        String   @unique
  baseUsername   String
  numericSuffix  Int
  isPremium      Boolean  @default(false)
  vanityId       String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tellyId])
  @@index([userId])
}

model Contact {
  id             String   @id @default(uuid())
  ownerId        String
  contactUserId  String
  displayName    String?
  tellyId        String
  notes          String?
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation("contactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser    User     @relation("contactUser", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactUserId])
  @@index([ownerId, isFavorite])
  @@index([tellyId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  message   String
  logs      String?
  platform  String?
  appVersion String?
  createdAt DateTime @default(now())
  user      User?    @relation("feedbackUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
