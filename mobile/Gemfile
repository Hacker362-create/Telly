# Gemfile — Telly mobile Fastlane dependencies
# Run `bundle install` before using Fastlane.
# Fastlane itself and every plugin is pinned so CI builds are reproducible.

source "https://rubygems.org"

gem "fastlane", "~> 2.220"

# ── Plugins ────────────────────────────────────────────────────────────────────
# Firebase App Distribution (both iOS + Android)
gem "fastlane-plugin-firebase_app_distribution"
